# ==============================================================================
# InterTrain Root .gitignore
# Prevents accidental leaks of sensitive API keys, secrets, build artifacts, 
# dependencies, runtime generated media, and OS/IDE cache files.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Sensitive Credentials (CRITICAL - DO NOT COMMIT)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!**/.env.example

# Secrets, Keys, Certificates & Credentials
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.pkcs12
secrets/
credentials.json
client_secret*.json
google-services*.json
GoogleService-Info*.plist

# ------------------------------------------------------------------------------
# 2. Python & Backend Runtime (Backend/)
# ------------------------------------------------------------------------------
# Bytecode and cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.coverage.*

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Runtime Generated Interview Data & Audio
Backend/sections/
Backend/audio/
sections/
audio/
*.wav
*.mp3
*.ogg
*.m4a

# Python distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Database files
*.db
*.sqlite
*.sqlite3

# ------------------------------------------------------------------------------
# 3. Node.js & Frontend (Frontend/)
# ------------------------------------------------------------------------------
node_modules/
Frontend/node_modules/
Frontend/dist/
Frontend/dist-ssr/
Frontend/build/
.npm/
.eslintcache
.stylelintcache
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 4. Operating System & Local Artifacts
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory

# ------------------------------------------------------------------------------
# 5. IDEs, Editors & AI Workspace Cache
# ------------------------------------------------------------------------------
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project
*.swp
*.swo

# AI & IDE Agent local scratch directories
.agents/
.gemini/
scratch/
