# InterTrain Backend Environment Variables

# OpenRouter API Key for generating AI interview questions and answer evaluations
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Model (optional, defaults to openai/gpt-oss-120b if not set)
OPENROUTER_MODEL=openai/gpt-oss-120b

# Deepgram API Key for real-time speech-to-text audio transcription
DEEPGRAM_API_KEY=your_deepgram_api_key_here

