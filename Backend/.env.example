# OpenRouter API Key (for LLM reasoning & questions)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key

# OpenRouter Model (default is openai/gpt-oss-120b or meta-llama/llama-3.3-70b-instruct)
OPENROUTER_MODEL=openai/gpt-oss-120b

# Deepgram API Key (for Speech-to-Text & Text-to-Speech)
# Get your key at: https://console.deepgram.com/
DEEPGRAM_API_KEY=your_deepgram_key

# Wandbox API URL (online code compiler for coding round)
WANDBOX_URL=https://wandbox.org/api
